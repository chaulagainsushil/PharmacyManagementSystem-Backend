  "name": "Paracetamol 500mg",
  "genericName": "Paracetamol",
  "categoryId": 2,
  "manufacturerId": 2,
  "tabletsPerStrip": 15,
  "strapsPerBox": 10,
  "stripPrice": 20.00,
  "tabletPrice": 1.35,
  "reorderLevel": 100,
  "requiresPrescription": false,
  "isActive": true
}

