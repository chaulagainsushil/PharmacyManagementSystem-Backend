      "purchasePricePerTablet": 2.00
    },
    {
      "medicineId": 5,
      "batchNumber": "ATV-2026-001",
      "supplierId": 2,
      "expiryDate": "2028-06-01T00:00:00Z",
      "quantityInTablets": 500,
      "purchasePricePerTablet": 9.00
    }
  ]
}


