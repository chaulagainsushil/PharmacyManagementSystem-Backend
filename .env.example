# ─────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# This file is safe to commit — it contains NO real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DB_CONNECTION_STRING=Host=your-db-host;Port=5432;Database=pmsdb;Username=pms_user;Password=your-password;SSL Mode=Require

# JWT secret key — must be at least 32 characters, keep it secret!
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# JWT token expiry in minutes
JWT_EXPIRY_MINUTES=60

# CORS — frontend origin(s)
CORS_ORIGINS=http://localhost:3000

# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Production
